# CogniCare Environment Configuration Template
# Copy to .env and adjust variables as needed

# Application Environment (development | staging | production)
APP_ENV=development
DEBUG=true
APP_NAME="CogniCare API"

# Server Ports
PORT=8000
FRONTEND_PORT=3000

# Security & Authentication
# Generate a strong 64-char key in production: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_ENABLED=true

# Database Connection
# SQLite (Local Dev):
DATABASE_URL=sqlite:///./cognicare.db
# PostgreSQL (Docker / Production):
# DATABASE_URL=postgresql://cognicare_user:cognicare_password@postgres:5432/cognicare_db

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Companion Integration
# Set USE_MOCK_AI=false and provide OPENAI_API_KEY for live LLM responses
USE_MOCK_AI=true
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# Frontend Next.js Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
